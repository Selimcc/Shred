{
  "name": "shred",
  "private": true,
  "version": "0.16.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --test-scheduled",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "build": "npm run typecheck && vite build",
    "build:demo": "vite build --mode demo",
    "deploy": "npm run build && wrangler deploy",
    "vapid": "node scripts/gen-vapid.mjs",
    "test": "node scripts/test-webpush.mjs && node scripts/test-reminders.mjs && node scripts/test-health.mjs && node scripts/test-auth.mjs && node scripts/test-knowledge.mjs && node scripts/test-flames.mjs && node scripts/test-coaching.mjs && node scripts/test-advisor.mjs && node scripts/test-dynamic.mjs && node scripts/test-sync.mjs && node scripts/test-endurance.mjs && node scripts/test-club.mjs && node scripts/test-social.mjs && node scripts/test-barcode.mjs && node scripts/test-usage.mjs",
    "setup": "node scripts/setup.mjs",
    "admin": "node scripts/admin.mjs",
    "build:native": "vite build --mode native",
    "build:ios": "vite build --mode native && cap sync ios",
    "ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0",
    "@capgo/capacitor-health": "8.11.14",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@cloudflare/workers-types": "^5.20261013.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "http_ece": "^1.2.1",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "wrangler": "^4.150.0"
  }
}
