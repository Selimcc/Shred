{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shred",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Les documents d'identité des clients OAuth (CIMD) sont récupérés sur l'internet public uniquement.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": { "enabled": true },

  // Seule la version en production répond. Pas d'URL d'aperçu par version ou par branche : une ancienne
  // version (ou une branche de test) servie à côté utiliserait les mêmes données avec un code dépassé.
  "workers_dev": true,
  "preview_urls": false,

  // Le front (dist/) et l'API sont servis par le même Worker : une seule URL, pas de CORS.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/manifest.webmanifest", "/.well-known/*"]
  },

  // Stockage clé-valeur : comptes, sessions, sauvegardes chiffrées, rappels, Santé.
  // npm run setup le crée et colle l'id ici.
  "kv_namespaces": [{ "binding": "KV", "id": "40104c1ad36948488ff181569284fdde" }],

  // Minuteur de repos : une alarme par personne, la notification part à la fin du repos.
  "durable_objects": {
    "bindings": [
      { "name": "TIMERS", "class_name": "RestTimer" },
      { "name": "CLUB", "class_name": "Club" },
      { "name": "USAGE", "class_name": "Usage" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RestTimer"] },
    { "tag": "v2", "new_sqlite_classes": ["Club"] },
    { "tag": "v3", "new_sqlite_classes": ["Usage"] }
  ],

  // Vérifie les rappels toutes les 15 minutes.
  "triggers": { "crons": ["*/15 * * * *"] },

  "vars": {
    "MODEL_VISION": "claude-sonnet-5-5",
    "MODEL_COACH": "claude-haiku-5-5",
    // Requêtes IA par jour (photo ou coach) : toi, puis chaque personne invitée. 0 = réservé à toi.
    "DAILY_AI_LIMIT": "60",
    "GUEST_AI_LIMIT": "10",
    "MOCK_AI": "0",
    "VAPID_SUBJECT": "mailto:selimjabnoun039@gmail.com"
  }
}
